# ==============================================================================
# Career Skill Intelligence Platform - Environment Configuration
# ==============================================================================

# Database Configuration (PostgreSQL container)
POSTGRES_DB=career_skill_db
POSTGRES_USER=myuser
POSTGRES_PASSWORD=mypassword

# Container Network Database & Redis Overrides (Optional - defaults to 'db' and 'redis' service names)
# COMPOSE_DATABASE_URL=postgresql://myuser:mypassword@db:5432/career_skill_db
# COMPOSE_REDIS_URL=redis://redis:6379/0

# Host Port Bindings (Optional - customize if host ports 80, 8000, 6379 are occupied)
FRONTEND_PORT=80
BACKEND_PORT=8000
REDIS_PORT=6379

# JWT Secret Key (REQUIRED: Must be at least 32 characters / 256 bits for HS256)
JWT_SECRET=career-skill-platform-super-secret-jwt-key-256bits-development-only

# AI Provider Configuration
# Choose "gemini" or "groq" (default: gemini)
LLM_PROVIDER=gemini
GEMINI_API_KEY=your_gemini_api_key_here
# Set GEMINI_MOCK=1 to run offline with synthetic test doubles (no external LLM API calls)
GEMINI_MOCK=0

# Groq Configuration (Required only if LLM_PROVIDER=groq)
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.1-8b-instant

# CORS Allowed Origins (Comma separated)
FRONTEND_ORIGINS=http://localhost,http://localhost:80,http://localhost:5173,http://localhost:8000

# Rate Limiting (Redis-backed multi-worker support)
RATE_LIMIT_REQUIREMENTS_ANALYZE=10/minute
RATE_LIMIT_CV_ANALYZE=5/minute

# Secure File Uploads
# Max upload size in bytes (10485760 bytes = 10 MB)
MAX_CV_UPLOAD_SIZE_BYTES=10485760
MAX_UPLOAD_SIZE_MB=10

# Storage Service Configuration ("local" or "s3")
STORAGE_BACKEND=local
UPLOAD_DIR=/app/uploads

# S3 Configuration (Optional - only required if STORAGE_BACKEND=s3)
# S3_BUCKET_NAME=career-skill-cv-uploads
# S3_ENDPOINT_URL=
# AWS_REGION=us-east-1
# AWS_ACCESS_KEY_ID=your_access_key
# AWS_SECRET_ACCESS_KEY=your_secret_key

# Google OAuth (Optional - obtain from console.cloud.google.com)
# GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com

# Migrations & DDL Execution (0: managed via Alembic scripts/run_migrations.py; 1: auto DDL fallback)
RUN_RUNTIME_DDL=0
