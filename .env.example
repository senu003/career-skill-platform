# Database Service Configuration (used by docker-compose)
POSTGRES_DB=career_skill_db
POSTGRES_USER=myuser
POSTGRES_PASSWORD=mypassword

# Backend Database URL
# For Docker Compose, the host is 'db'
DATABASE_URL=postgresql://myuser:mypassword@db:5432/career_skill_db

# Gemini API Key (Required for ML features)
GEMINI_API_KEY=your_gemini_api_key_here

# JWT Security Key (Must be at least 32 characters / 256 bits for HS256)
JWT_SECRET=career-skill-platform-super-secret-jwt-key-256bits-development-only

# CORS settings (Comma separated origins)
# For local Docker setup, http://localhost is where the frontend is served
FRONTEND_ORIGINS=http://localhost,http://localhost:5173
