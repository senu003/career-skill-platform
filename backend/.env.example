DATABASE_URL=postgresql://postgres:postgres@localhost:5432/career_skill_db
GEMINI_API_KEY=your_gemini_api_key_here
JWT_SECRET=career-skill-platform-super-secret-jwt-key-256bits-development-only
FRONTEND_ORIGINS=http://localhost:5173
# LLM provider: "groq" or "gemini" (default: gemini)
LLM_PROVIDER=groq
# Groq API key (required when LLM_PROVIDER=groq)
GROQ_API_KEY=your_groq_api_key_here
# Groq model — must be a model ID from https://console.groq.com/docs/models that supports JSON mode.
# Retired/unsupported: llama3-8b-8192, openai/gpt-oss-20b, openai/gpt-oss-120b
# Recommended: llama-3.1-8b-instant, llama-3.1-70b-versatile, mixtral-8x7b-32768
GROQ_MODEL=llama-3.1-8b-instant
# Set to "1" to skip LLM calls and use mock responses (for local testing)
GEMINI_MOCK=0

# Redis Rate Limiting (Multi-worker cluster support)
# Set to Redis instance URL; falls back to in-memory limiter if omitted
REDIS_URL=redis://localhost:6379/0
RATE_LIMIT_REQUIREMENTS_ANALYZE=10/minute
RATE_LIMIT_CV_ANALYZE=5/minute

# Google OAuth (Optional — obtain from console.cloud.google.com)
# GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com

# Secure File Uploads
# Configurable upload size limit in bytes (default 10 MB = 10485760 bytes). Oversized files rejected early.
MAX_CV_UPLOAD_SIZE_BYTES=10485760

# Storage Service Configuration
# Choices: "local" (default) or "s3"
STORAGE_BACKEND=local
UPLOAD_DIR=uploads

# S3 Configuration (only required if STORAGE_BACKEND=s3)
# S3_BUCKET_NAME=my-secure-cv-bucket
# S3_REGION=us-east-1
# AWS_ACCESS_KEY_ID=your_access_key
# AWS_SECRET_ACCESS_KEY=your_secret_key

# Database Migrations
# Set to 0 to disable dynamic DDL on FastAPI startup (migrations run via scripts/run_migrations.py)
RUN_RUNTIME_DDL=0
